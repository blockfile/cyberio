# ───────────────────────────────────────────────────────────────────────────
# CYBERIO — CLIENT env (.env)  ·  copy to .env and fill in
# REACT_APP_* values are baked at BUILD time → after editing, run `npm run build`.
# Anything here ships in the PUBLIC JS bundle, so do NOT put real secrets here;
# use an RPC key that is rate/referrer-limited.
# ───────────────────────────────────────────────────────────────────────────

# Solana RPC (use a keyed QuickNode/Helius endpoint for reliability).
REACT_APP_SOLANA_RPC=
REACT_APP_SOLANA_RPC_FALLBACKS=

# CYBERIO SPL token (cards / market / wagers).
REACT_APP_TOKEN_MINT=DttktP1JiM63zGLSALiKs788mMYCunzRoZfCiwRFpump
REACT_APP_TOKEN_DECIMALS=6

# Card-draw payment recipient — MUST match server DRAW_TREASURY.
REACT_APP_DRAW_TREASURY=8yUGx6tMGsCxSdVj2Fk8FyaDkg4doZ32xnkNkzKSwHe5

# PVP wager treasury — the server supplies the real one at runtime; leave blank.
REACT_APP_TREASURY_ADDRESS=

# Max wager (whole tokens).
REACT_APP_MAX_BET_TOKENS=100000

# API / Socket base URL. In production these are same-origin; leave blank to auto-detect.
REACT_APP_API_URL=
REACT_APP_SOCKET_URL=
