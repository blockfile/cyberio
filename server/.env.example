# ───────────────────────────────────────────────────────────────────────────
# CYBERIO — SERVER env (server/.env)  ·  copy to server/.env and fill in
# Applied on `pm2 restart`. NEVER commit real values (this file stays a template).
# ───────────────────────────────────────────────────────────────────────────

# ── Secrets (no defaults — must be set) ─────────────────────────────────────
# MongoDB connection string.
MONGO_URI=

# Treasury signing wallet — base58 secret key. Pays rewards + owns the PVP escrow.
# Its public key is the PVP/wager treasury the client is told to pay at runtime.
TREASURY_PRIVATE_KEY=

# ── Solana RPC (keyed endpoint recommended) ─────────────────────────────────
SOLANA_RPC=
QUICKNODE_RPC_URL=
SOLANA_RPC_FALLBACKS=

# ── Token & treasuries (public values) ──────────────────────────────────────
CYBERIO_TOKEN_MINT=DttktP1JiM63zGLSALiKs788mMYCunzRoZfCiwRFpump
CYBERIO_DECIMALS=6

# Card-draw payment recipient — MUST match client REACT_APP_DRAW_TREASURY.
DRAW_TREASURY=8yUGx6tMGsCxSdVj2Fk8FyaDkg4doZ32xnkNkzKSwHe5

# ── Pricing / economy ───────────────────────────────────────────────────────
DRAW_PRICE_CYBERIO=5000
RAKE_BPS=0
FEE_WALLET=

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3001
FRONTEND_ORIGIN=

# ── Optional tuning (sensible defaults already baked in code) ────────────────
# EARN_DAILY_CAP=30000
# EARN_PENALTY_BASE_MS=300000
# PASS_PRICE_7=5000
# PASS_PRICE_15=9000
# PASS_PRICE_30=15000
